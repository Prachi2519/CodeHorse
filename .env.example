# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Better Auth
# Use your production Vercel/custom domain in production.
BETTER_AUTH_URL="https://your-codehorse-domain.vercel.app"
NEXT_PUBLIC_APP_BASE_URL="https://your-codehorse-domain.vercel.app"
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_TRUSTED_ORIGINS="https://your-codehorse-domain.vercel.app"

# GitHub OAuth app
# Production callback URL:
# https://your-codehorse-domain.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID="replace-with-github-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-client-secret"
GITHUB_WEBHOOK_SECRET="replace-with-random-webhook-secret"

# Inngest production
INNGEST_EVENT_KEY="replace-with-inngest-event-key"
INNGEST_SIGNING_KEY="replace-with-inngest-signing-key"

# AI and repository indexing
GOOGLE_GENERATIVE_AI_API_KEY="replace-with-google-ai-key"
PINECONE_API_KEY="replace-with-pinecone-key"
PINECONE_DB_API_KEY="replace-with-pinecone-key"
PINECONE_INDEX_NAME="coderabbit"
